{
  "name": "jelly-dnd",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true,
  "scripts": {
    "audio": "node scripts/elevenlabs.js",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json,html,css}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,json,html,css}\"",
    "start": "node scripts/server.js",
    "build": "npm run check && node scripts/build-itch.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --experimental-vm-modules --import ./tests/setup.js --test tests/module-loading.test.js tests/level-loader.test.js tests/sky-height.test.js tests/shared-camera.test.js tests/progression.test.js tests/game.test.js tests/physics.test.js tests/soft-body.test.js tests/level-features.test.js tests/portals.test.js tests/combat.test.js tests/drones.test.js tests/game-effects.test.js tests/game-audio.test.js tests/stacking.test.js tests/camera.test.js tests/levels.test.js tests/conveyor.test.js tests/editor-space.test.js tests/voxel.test.js tests/color-blocks.test.js tests/spikes.test.js tests/pillars.test.js",
    "test:color-blocks:browser": "node tests/browser-color-blocks.js",
    "test:glass-blocks:browser": "node tests/browser-glass-blocks.js",
    "test:spikes:browser": "node tests/browser-spikes.js",
    "test:spike-style:browser": "node tests/browser-spike-style.js",
    "test:torches:browser": "node tests/browser-torches.js",
    "test:drones:browser": "node tests/browser-drones.js",
    "test:portals:browser": "node tests/browser-portals.js",
    "test:palette:browser": "node tests/browser-palette.js",
    "test:browser": "node tests/browser-tests.js",
    "test:combat:browser": "node tests/browser-combat.js",
    "test:editor:browser": "node tests/browser-editor.js",
    "test:editor:3d": "node tests/browser-editor-3d.js",
    "test:editor:input": "node tests/browser-editor-input.js",
    "test:parties:browser": "node tests/browser-parties.js",
    "test:voxels:browser": "node tests/browser-voxels.js",
    "test:conveyor:browser": "node tests/browser-conveyor.js",
    "test:dice": "node tests/browser-dice.js",
    "profile:browser": "node tests/browser-smoke.js",
    "profile:compare": "node tests/browser-performance.js",
    "profile:solver": "node tests/solver-fingerprint.js",
    "test:menu:browser": "node tests/browser-menu.js",
    "test:atmosphere:browser": "node tests/browser-atmosphere.js",
    "test:assembly:browser": "node tests/browser-assembly.js",
    "test:bridges:browser": "node tests/browser-bridges.js",
    "test:see-through:browser": "node tests/browser-see-through.js",
    "test:density:browser": "node tests/browser-density.js",
    "test:start-camera:browser": "node tests/browser-start-camera.js",
    "test:camera:browser": "node tests/browser-shared-camera.js",
    "test:layout:browser": "node tests/browser-960.js",
    "test:editor:compact": "node tests/browser-editor-compact.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "3.9.10"
  },
  "type": "module"
}
